APP_NAME="MailCheck API"
APP_VERSION="1.0.0"
DEBUG=false
MAX_EMAILS_PER_REQUEST=500
DNS_TIMEOUT=4.0
SMTP_TIMEOUT=5.0
ENABLE_SMTP_CHECK=true
SMTP_HELO_DOMAIN="mailcheck.verifier.local"
SMTP_SENDER_EMAIL="verify@mailcheck.verifier.local"
CONCURRENCY_LIMIT=20
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
